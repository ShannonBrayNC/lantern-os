# Local development mode
LANTERN_AUTH_MODE=local
LANTERN_LOCAL_NAME=Lantern Owner
LANTERN_LOCAL_EMAIL=owner@localhost
LANTERN_LOCAL_ROLE=Owner

# Microsoft Entra ID mode
# LANTERN_AUTH_MODE=entra
# LANTERN_SESSION_SECRET=replace-with-at-least-32-random-characters
# LANTERN_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# LANTERN_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# LANTERN_ENTRA_CLIENT_SECRET=replace-with-secret
# LANTERN_ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
# LANTERN_ENTRA_DEFAULT_ROLE=Viewer
# LANTERN_COOKIE_HTTPS_ONLY=false
